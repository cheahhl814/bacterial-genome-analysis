nextflow.enable.dsl = 2

manifest {
    name            = 'bacterial-genome-analysis/nextflow-runner'
    author          = 'AIx-BIO'
    homePage        = 'https://github.com/cheahhl814/AIx-BIO'
    description     = 'Thin Nextflow DSL2 runner for the bacterial-genome-analysis bash sub-skills (v5.1)'
    version         = '5.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    // inputs
    reads        = null   // Short-read FASTQ pairs glob, e.g. 'reads/*_{1,2}.fq.gz'
    long_reads   = null   // Long-read FASTQ glob, e.g. 'reads/*_long.fq.gz'
    sample_sheet = null   // Optional CSV: sample_id,fastq_1,fastq_2
    mode         = 'auto' // short | long | hybrid | auto
    outdir       = 'results'
    genome_size  = null   // Optional QUAST hint, e.g. "2.9m" for E. coli (--est-ref-size)

    // external databases — default to the skill's reusable cache under
    // assets/ (see ../../assets/README.md) so a database downloaded once
    // via a bash sub-skill run is reused here with zero extra flags.
    // Override with an absolute path if your DB lives elsewhere.
    kraken2_db          = "${projectDir}/../../assets/kraken2_db"   // used if --run_kraken true
    busco_lineage       = 'bacteria_odb12'
    busco_download_path = "${projectDir}/../../assets/busco_downloads"
    bakta_db             = "${projectDir}/../../assets/bakta_db"    // used if --run_bakta true

    // step toggles
    run_quast   = true
    run_busco   = true
    run_checkm  = true
    run_kraken  = false  // read-level contamination screen (preflight 2d)
    run_bakta   = true
    run_pypolca = false  // optional extra short-read polish round after Polypolish

    // tool defaults
    medaka_model = 'r1041_e82_400bps_sup_v4.3.0'
    flye_mode    = '--nano-hq'

    // publishing
    publish_dir_mode = 'copy'
    max_memory       = 128.GB
    max_cpus         = 32
    max_time         = 72.h
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = ''
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

trace   { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt" }
report  { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
timeline{ enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
