// Per-process resource blocks + publishDir — mirrors nf-core/bacass resource layout.
// Resource hints: SPAdes/Flye/Unicycler/BUSCO/CheckM -> process_high;
// Polypolish/Pypolca/Medaka/Bakta -> process_medium; QUAST -> process_low.
process {

    withName: 'PREFLIGHT' {
        publishDir = [ path: { "${params.outdir}/preflight" }, mode: params.publish_dir_mode ]
    }
    withName: 'KRAKEN2_READS' {
        publishDir = [ path: { "${params.outdir}/preflight/kraken2_reads" }, mode: params.publish_dir_mode, pattern: '*.report.txt' ]
    }
    withName: 'SPADES_ASSEMBLY' {
        cpus = 12; memory = 72.GB; time = 16.h
        publishDir = [ path: { "${params.outdir}/assembly/spades" }, mode: params.publish_dir_mode, pattern: '*.{fasta,txt}' ]
    }
    withName: 'FLYE_ASSEMBLY' {
        cpus = 12; memory = 72.GB; time = 16.h
        publishDir = [ path: { "${params.outdir}/assembly/flye" }, mode: params.publish_dir_mode, pattern: '*.{fasta,log}' ]
    }
    withName: 'UNICYCLER_ASSEMBLY' {
        cpus = 12; memory = 72.GB; time = 16.h
        publishDir = [ path: { "${params.outdir}/assembly/unicycler" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }
    withName: 'MEDAKA_POLISH' {
        cpus = 6; memory = 36.GB; time = 8.h
        publishDir = [ path: { "${params.outdir}/polishing/medaka" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }
    withName: 'MAP_SHORT_READS' {
        cpus = 6; memory = 36.GB; time = 8.h
        publishDir = [ path: { "${params.outdir}/polishing/reads_mapped" }, mode: params.publish_dir_mode, pattern: '*.bam*' ]
    }
    withName: 'POLYPOLISH' {
        cpus = 6; memory = 36.GB; time = 8.h
        publishDir = [ path: { "${params.outdir}/polishing/polypolish" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }
    withName: 'PYPOLCA_POLISH' {
        cpus = 6; memory = 36.GB; time = 8.h
        publishDir = [ path: { "${params.outdir}/polishing/pypolca" }, mode: params.publish_dir_mode, pattern: '*.fasta' ]
    }
    withName: 'QUAST' {
        cpus = 2; memory = 12.GB; time = 4.h
        publishDir = [ path: { "${params.outdir}/qc/quast" }, mode: params.publish_dir_mode ]
    }
    withName: 'BUSCO' {
        cpus = 12; memory = 72.GB; time = 16.h
        publishDir = [ path: { "${params.outdir}/qc/busco" }, mode: params.publish_dir_mode ]
    }
    withName: 'CHECKM' {
        cpus = 12; memory = 72.GB; time = 16.h
        publishDir = [ path: { "${params.outdir}/qc/checkm" }, mode: params.publish_dir_mode ]
    }
    withName: 'BAKTA_ANNOTATE' {
        cpus = 6; memory = 36.GB; time = 8.h
        publishDir = [ path: { "${params.outdir}/annotation/bakta" }, mode: params.publish_dir_mode ]
    }
}
