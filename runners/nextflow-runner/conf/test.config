// Test profile: tiny local dataset, no external databases, no heavy QC.
// Run with:  nextflow run main.nf -profile test
// Graph check: nextflow run main.nf -profile test -stub-run
params {
    reads      = "${projectDir}/test_data/reads/*_{1,2}.fastq.gz"
    outdir     = "test_results"
    mode       = 'short'
    run_quast  = false
    run_busco  = false
    run_checkm = false
    run_bakta  = false
    run_kraken = false
}

// Tiny resource caps so the test profile runs on any machine.
// resourceLimits clamps every process's declared cpus/memory/time.
process {
    resourceLimits = [ cpus: 2, memory: 2.GB, time: 4.h ]
}
